# Server-only demo access credentials.
# Set these in the Vercel project environment; never prefix them with VITE_.
TERRASATCH_DEMO_USERNAME=terrain-operator
TERRASATCH_DEMO_PASSWORD=replace-with-a-long-random-access-key
TERRASATCH_DEMO_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional demo destinations used by the protected client gallery.
VITE_FIELD_SUPPORT_DEMO_URL=https://terrasatch-field-support-rosy.vercel.app/
VITE_AVYTS_PARTNER_DEMO_URL=https://avyts-partner-demo.vercel.app/
VITE_SNOWBIRD_RELAY_DEMO_URL=https://wasatch-relay-snowbird.vercel.app/today
VITE_UAC_RELAY_DEMO_URL=https://uac-wasatch-relay.vercel.app/today
VITE_AI_RADIO_DEMO_URL=https://ai-radio-demo.vercel.app/

# Public TerraSatch Edge release asset URLs.
# Set these to public release/CDN URLs only after each native pilot build is validated and uploaded.
# They are public download metadata, not secrets.
VITE_EDGE_WINDOWS_X64_URL=
VITE_EDGE_WINDOWS_X64_SHA256=
VITE_EDGE_MACOS_ARM64_URL=
VITE_EDGE_MACOS_X64_URL=
VITE_EDGE_LINUX_AMD64_URL=
VITE_EDGE_LINUX_ARM64_URL=

# Server-only website inquiry delivery. Verify the sender domain with Resend.
RESEND_API_KEY=replace-with-a-server-only-resend-key
TERRASATCH_INQUIRY_FROM=TerraSatch Website <inquiries@terrasatch.com>
